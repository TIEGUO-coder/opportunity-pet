{
  "name": "opportunity-pet",
  "version": "0.1.2",
  "description": "A desktop scout pet that brings product opportunities back for review.",
  "main": "src/main.js",
  "scripts": {
    "install:electron": "npx install-electron --no",
    "prepare:assets": "node scripts/extract-sprites.js",
    "start": "electron .",
    "check": "node scripts/verify-assets.js && node scripts/test-pet-generation.js && node scripts/test-pet-animation-timing.js && node scripts/test-scout-preferences.js && node scripts/test-creator-store-blueprint.js && node scripts/test-mah-integration.js",
    "check:local-fallback": "electron scripts/test-local-cartoon-fallback.js",
    "capture:demo": "electron scripts/capture-demo-screenshots.js",
    "capture:gif": "electron scripts/create-readme-demo-gif.js",
    "capture:scout": "electron scripts/capture-real-scout-gif.js",
    "dist": "electron-builder --publish never",
    "dist:dir": "electron-builder --dir"
  },
  "keywords": [
    "desktop-pet",
    "electron",
    "opportunity",
    "ai-builder"
  ],
  "author": "TIEGUO-coder",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "pngjs": "latest"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "gif-encoder-2": "^1.0.5"
  },
  "build": {
    "appId": "com.tieguocoder.opportunitypet",
    "productName": "Opportunity Pet",
    "asar": true,
    "artifactName": "Opportunity-Pet-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "skills",
        "to": "skills"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Opportunity-Pet-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Opportunity-Pet-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage"
      ]
    }
  }
}
